{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
    	"type": "file",
    	"source": "/home/busiedcake7945/.config/fastfetch/logo.txt"
    },
    "display": {
        "separator": " → ",
        "color": {
            "keys": "blue",
            "title": "red"
        },
        "key": {
            "type": "string"
        },
        "bar": {
            "width": 10,
            "char": {
                "elapsed": "■",
                "total": "-",
            },
        },
        "percent": {
            "type": 9,
            "color": {
                "green": "green",
                "yellow": "light_yellow",
                "red": "light_red"
            }
        }
    },
    "modules": [
    	{
    		"type": "custom",
    		"key": " ",
    		"format": "I use Artix BTW",
    		"separator": false
    	},
        "title",
        {
        "type": "separator",
        "string": "»»»»»»»»»»»»»»»»»»»»»»",
        "color": "green"
        },
        "os",
        "host",
        "kernel",
        "initsystem",
        "uptime",
        "packages",
        "shell",
        "editor",
        "lm",
        "de",
        "wm",
        "wmtheme",
        "theme",
        "icons",
        "cursor",
        "terminal",
        {
            "type": "cpu",
            "showPeCoreCount": true,
            "temp": true
        },
        {
            "type": "gpu",
            "driverSpecific": true,
            "temp": true
        },
        {
            "type": "codec",
            "splitGPU": true
        },
        "memory",
        "swap",
        "disk",
        "locale",
        "vulkan",
        "opengl",
        "opencl"
    ]
}
